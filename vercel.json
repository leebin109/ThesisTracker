{
  "rewrites": [
    { "source": "/api/opendart/:path*", "destination": "/api/proxy?service=opendart&path=:path*" },
    { "source": "/api/sec/:path*",      "destination": "/api/proxy?service=sec&path=:path*" },
    { "source": "/api/yahoo/:path*",    "destination": "/api/proxy?service=yahoo&path=:path*" },
    { "source": "/((?!api/).*)",        "destination": "/terminal.html" }
  ],
  "headers": [
    {
      "source": "/(.*)\\.html",
      "headers": [
        { "key": "Content-Type", "value": "text/html; charset=utf-8" }
      ]
    }
  ]
}
