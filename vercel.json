{
  "functions": {
    "api/proxy.mjs": {
      "maxDuration": 30
    }
  },
  "rewrites": [
    { "source": "/api/opendart/:endpoint",          "destination": "/api/proxy?service=opendart&path=:endpoint" },
    { "source": "/api/yahoo/search",                "destination": "/api/proxy?service=yahoo&path=search" },
    { "source": "/api/yahoo/quote",                 "destination": "/api/proxy?service=yahoo&path=quote" },
    { "source": "/api/yahoo/chart/:symbol",         "destination": "/api/proxy?service=yahoo&path=chart&symbol=:symbol" },
    { "source": "/api/yahoo/quoteSummary/:symbol",  "destination": "/api/proxy?service=yahoo&path=quoteSummary&symbol=:symbol" },
    { "source": "/api/yahoo/timeseries/:symbol",    "destination": "/api/proxy?service=yahoo&path=timeseries&symbol=:symbol" },
    { "source": "/api/sec/files/company_tickers.json", "destination": "/api/proxy?service=sec&path=files/company_tickers.json" },
    { "source": "/api/sec/archives/:path*",         "destination": "/api/proxy?service=sec&path=archives&archivePath=:path*" },
    { "source": "/api/sec/:section/:file",          "destination": "/api/proxy?service=sec&path=:section&file=:file" },
    { "source": "/((?!api/).*)",        "destination": "/terminal.html" }
  ],
  "headers": [
    {
      "source": "/(.*)\\.html",
      "headers": [
        { "key": "Content-Type", "value": "text/html; charset=utf-8" }
      ]
    }
  ]
}
